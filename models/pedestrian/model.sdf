<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ped1">
    <link name="body">
      <gravity>false</gravity>
      <inertial><mass>70</mass><inertia><ixx>10</ixx><iyy>10</iyy><izz>2</izz></inertia></inertial>
      <visual name="torso"><pose>0 0 0.80 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.50</length></cylinder></geometry>
        <material><ambient>0.2 0.3 0.7 1</ambient><diffuse>0.2 0.3 0.7 1</diffuse></material></visual>
      <visual name="head"><pose>0 0 1.65 0 0 0</pose><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material></visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/ped1/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
