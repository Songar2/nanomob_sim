<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 11 m × 2.5 m × 3.1 m 버스. 모델 원점 = 바닥 중심, +x = 전방. 충돌 지오메트리 없음(접촉은 러너가 기하로 판정) -->
  <model name="bus1">
    <link name="body">
      <gravity>false</gravity>
      <inertial><mass>10000</mass><inertia><ixx>1e4</ixx><iyy>1e5</iyy><izz>1e5</izz></inertia></inertial>
      <visual name="shell"><pose>0 0 1.85 0 0 0</pose><geometry><box><size>11 2.5 2.5</size></box></geometry>
        <material><ambient>0.05 0.45 0.35 1</ambient><diffuse>0.05 0.45 0.35 1</diffuse></material></visual>
      <visual name="belt"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>10.8 2.4 0.5</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      <visual name="windows_l"><pose>-0.2 1.26 2.2 0 0 0</pose><geometry><box><size>9.4 0.03 0.9</size></box></geometry>
        <material><ambient>0.1 0.15 0.2 1</ambient><diffuse>0.1 0.15 0.2 1</diffuse></material></visual>
      <visual name="windows_r"><pose>-0.2 -1.26 2.2 0 0 0</pose><geometry><box><size>9.4 0.03 0.9</size></box></geometry>
        <material><ambient>0.1 0.15 0.2 1</ambient><diffuse>0.1 0.15 0.2 1</diffuse></material></visual>
      <visual name="windshield"><pose>5.51 0 2.2 0 0 0</pose><geometry><box><size>0.03 2.2 1.1</size></box></geometry>
        <material><ambient>0.1 0.15 0.2 1</ambient><diffuse>0.1 0.15 0.2 1</diffuse></material></visual>
      <visual name="headlight_l"><pose>5.51 0.9 0.95 0 0 0</pose><geometry><box><size>0.04 0.35 0.2</size></box></geometry>
        <material><ambient>1 1 0.7 1</ambient><diffuse>1 1 0.7 1</diffuse><emissive>1 1 0.7 1</emissive></material></visual>
      <visual name="headlight_r"><pose>5.51 -0.9 0.95 0 0 0</pose><geometry><box><size>0.04 0.35 0.2</size></box></geometry>
        <material><ambient>1 1 0.7 1</ambient><diffuse>1 1 0.7 1</diffuse><emissive>1 1 0.7 1</emissive></material></visual>
      <visual name="bumper"><pose>5.5 0 0.55 0 0 0</pose><geometry><box><size>0.1 2.4 0.25</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="wheel_fl"><pose>3.6 1.1 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_fr"><pose>3.6 -1.1 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_rl"><pose>-3.4 1.1 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_rr"><pose>-3.4 -1.1 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/bus1/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
