<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 영상 녹화용 관찰 카메라. 러너가 시행마다 set_pose 로 위치를 옮긴다 -->
  <model name="spectator">
    <link name="cam">
      <gravity>false</gravity>
      <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      <sensor name="spectator_cam" type="camera">
        <update_rate>30</update_rate>
        <topic>spectator/image</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>200</far></clip>
        </camera>
        <always_on>1</always_on><visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
